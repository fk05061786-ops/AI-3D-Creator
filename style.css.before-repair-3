* { box-sizing: border-box; touch-action: manipulation; }
body, html {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #101827;
  color: #e2e8f0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  user-select: none;
}
#app {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100dvh;
}
header {
  height: 50px;
  padding: 0 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #1e293b;
  border-bottom: 1px solid #334155;
  flex-shrink: 0;
}
header h2 { font-size: 16px; font-weight: 700; margin: 0; color: #f8fafc; }
.project-bar { display: flex; align-items: center; gap: 8px; }
.status { font-size: 12px; color: #94a3b8; }
.toolbar {
  display: flex;
  gap: 6px;
  padding: 8px;
  background: #0f172a;
  border-bottom: 1px solid #1e293b;
  overflow-x: auto;
  white-space: nowrap;
  flex-shrink: 0;
  -webkit-overflow-scrolling: touch;
}
.toolbar button, .actions button {
  border: 0;
  border-radius: 6px;
  padding: 8px 12px;
  color: #ffffff;
  background: #3b82f6;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  flex-shrink: 0;
}
.toolbar button:active, .actions button:active { background: #2563eb; }
.toolbar button.danger, .actions button.danger { background: #ef4444; }
.toolbar button.danger:active, .actions button.danger:active { background: #dc2626; }
.ghost { background: transparent !important; border: 1px solid #475569 !important; color: #cbd5e1 !important; }
.ghost:active { background: #334155 !important; }

.main-layout {
  display: flex;
  flex: 1;
  position: relative;
  overflow: hidden;
}
#viewport {
  flex: 1;
  width: 100%;
  height: 100%;
  position: relative;
  background: #182235;
}
#viewport canvas { width: 100% !important; height: 100% !important; display: block; }

.sidebar {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 240px;
  max-height: calc(100% - 20px);
  display: flex;
  flex-direction: column;
  gap: 10px;
  z-index: 10;
  pointer-events: none;
}
.panel {
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(8px);
  border: 1px solid #334155;
  border-radius: 8px;
  padding: 12px;
  pointer-events: auto;
  overflow-y: auto;
  max-height: 250px;
}
.panel h3 { margin: 0 0 10px 0; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; }
.panel.empty { font-size: 12px; color: #64748b; text-align: center; }
.field { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-size: 12px; gap: 8px; }
.field input[type="text"] { background: #1e293b; border: 1px solid #475569; border-radius: 4px; color: #fff; padding: 4px 8px; width: 100px; }
.field input[type="color"] { border: 0; background: none; width: 28px; height: 28px; cursor: pointer; }
.field input[type="range"] { flex: 1; }
.val { font-family: monospace; font-size: 11px; width: 28px; text-align: right; }
.seg { display: flex; gap: 2px; background: #1e293b; padding: 2px; border-radius: 4px; }
.seg button { padding: 4px 8px; font-size: 11px; background: transparent; color: #94a3b8; border: 0; border-radius: 3px; }
.seg button.active { background: #3b82f6; color: #fff; }
.actions { display: flex; gap: 6px; margin-top: 10px; }
.actions button { flex: 1; padding: 6px; font-size: 12px; }

.hierarchy { list-style: none; padding: 0; margin: 0; }
.hierarchy-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px;
  background: transparent;
  border: 0;
  border-radius: 4px;
  color: #cbd5e1;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
}
.hierarchy-item:active, .hierarchy-item.active { background: #1e293b; color: #3b82f6; }
.dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
.name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.badge { font-size: 9px; background: #334155; padding: 2px 4px; border-radius: 3px; color: #94a3b8; text-transform: uppercase; }

footer {
  height: 30px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f172a;
  border-top: 1px solid #1e293b;
  font-size: 11px;
  color: #64748b;
  flex-shrink: 0;
}

@media (max-width: 600px) {
  .sidebar {
    position: static;
    width: 100%;
    max-height: 180px;
    flex-direction: row;
    padding: 8px;
    background: #0f172a;
    border-top: 1px solid #1e293b;
  }
  .panel { flex: 1; max-height: 100%; }
  .main-layout { flex-direction: column; }
}