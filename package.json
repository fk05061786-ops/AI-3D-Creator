{
  "name": "ai-3d-creator",
  "version": "1.0.0",
  "description": "AI-3D-Creator - browser and desktop 3D editor with rigging, animation and export",
  "author": "AI-3D-Creator",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "npm run test:rig && npm run test:anim && npm run test:api && npm run test:mcp",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test:rig": "esbuild scripts/rig-selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rig-selftest.mjs && node node_modules/.cache/rig-selftest.mjs",
    "typecheck": "tsc --noEmit",
    "test:api": "esbuild scripts/api-selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/api-selftest.mjs && node node_modules/.cache/api-selftest.mjs",
    "test:anim": "esbuild scripts/anim-export-selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/anim-export-selftest.mjs && node node_modules/.cache/anim-export-selftest.mjs",
    "test:browser": "node scripts/browser-e2e.mjs",
    "test:mcp": "node --experimental-strip-types scripts/mcp-selftest.ts",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "mcp:build": "esbuild scripts/mcp-server.ts --bundle --platform=node --format=esm --outfile=dist-mcp/mcp-server.mjs",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && npm run mcp:build && electron-builder --win --x64",
    "desktop:build:mac": "npm run build && npm run mcp:build && electron-builder --mac",
    "desktop:dist": "npm run build && npm run mcp:build && electron-builder --win --x64 --mac"
  },
  "keywords": [],
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.187.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "typescript-language-server": "^6.0.3",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.ai3dcreator.desktop",
    "productName": "AI 3D Creator",
    "copyright": "AI-3D-Creator",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-mcp",
        "to": "mcp"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI 3D Creator"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-android-arm64": "^4.68.3"
  }
}
