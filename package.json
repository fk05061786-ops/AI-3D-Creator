{
  "name": "ai-3d-creator",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test:rig && npm run test:anim && npm run test:api",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test:rig": "esbuild scripts/rig-selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rig-selftest.mjs && node node_modules/.cache/rig-selftest.mjs",
    "typecheck": "tsc --noEmit",
    "test:api": "esbuild scripts/api-selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/api-selftest.mjs && node node_modules/.cache/api-selftest.mjs",
    "test:anim": "esbuild scripts/anim-export-selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/anim-export-selftest.mjs && node node_modules/.cache/anim-export-selftest.mjs",
    "test:browser": "node scripts/browser-e2e.mjs"
  },
  "keywords": [],
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@types/three": "^0.187.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/rollup-android-arm64": "^4.68.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "typescript-language-server": "^6.0.3",
    "vite": "^7.3.7"
  }
}
